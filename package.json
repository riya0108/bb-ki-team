{
  "name": "bb-ki-team",
  "version": "1.0.0",
  "description": "Bull or Bear AI Content Creation Team",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/agents/*",
    "packages/mcp-servers/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run --no-file-parallelism",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace=@bb/dashboard",
    "db:migrate": "tsx --env-file=.env packages/db/src/migrate.ts",
    "x:verify": "tsx --env-file=.env packages/mcp-servers/x/src/verify.ts",
    "buffer:verify": "tsx --env-file=.env packages/mcp-servers/buffer/src/verify.ts",
    "api": "tsx watch --env-file=.env apps/api/src/server.ts",
    "worker": "tsx watch --env-file=.env apps/worker/src/index.ts",
    "dashboard": "npm run dev --workspace=@bb/dashboard",
    "dev": "concurrently -n api,dashboard -c blue,magenta \"npm run api\" \"npm run dashboard\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "concurrently": "^9.1.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
