# Search sources — the agent runs on Wikipedia alone (no key needed) and adds
# News/YouTube automatically once their keys below are set.

# Wikipedia REST API (packages/mcp-servers/search-wikipedia) — no key required.

# NewsAPI.org (packages/mcp-servers/search-news) — free dev tier, 100 req/day.
# https://newsapi.org/register
NEWS_API_KEY=

# YouTube Data API v3 (packages/mcp-servers/search-youtube) — metadata only,
# free quota. https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Groq API (free tier) — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
