# LLM providers — tried in this order (Gemini primary, Groq fallback, OpenRouter
# further fallback, Ollama last resort), skipping any without a key. All four use
# an OpenAI-compatible /chat/completions endpoint (packages/core/src/llm.ts). At
# least one must be set. Ollama was added 2026-09-15 after gemini+groq+openrouter
# all hit rate limits/quota simultaneously on the same free-tier accounts — a real
# fallback for that, not a replacement for the other three. (Cerebras was
# considered first but rejected: its free tier requires a credit card on file,
# which this project deliberately avoids for any LLM provider.)

# Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Groq (free tier) — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (free-tier models available) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Ollama (local, genuinely free — no account, no API key, no card, ever) — runs on
# this machine via `brew services start ollama`. Slower and lower-quality than the
# cloud providers above (a small model chosen to fit comfortably in 8GB RAM
# alongside everything else already running), so it's a last-resort fallback, not
# a replacement. Setting OLLAMA_MODEL alone enables it — no key needed.
# Pull the model once with: ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b

# Postgres (packages/db) — points at the hosted Supabase project so the app,
# apps/worker, and the Supabase pg_cron job (see the "Scheduled blog firing" section
# below) all share one source of truth. Get this from the Supabase dashboard:
# Project Settings → Database → Connection string → "Session pooler" tab (NOT
# "Direct connection" — that hostname is IPv6-only and won't resolve on most
# networks). If the password contains `@`, `#`, or other URI-special characters,
# percent-encode them within the connection string (`@` -> `%40`, `#` -> `%23`, etc.)
# or the app will silently mis-parse the connection string / .env's own parser may
# truncate the value at an unescaped `#`. `npm run db:migrate` applies the schema.
DATABASE_URL=

# For pure local development against a local Postgres instead of hosted Supabase
# (`docker compose up -d` runs one matching this connection string).
LOCAL_DATABASE_URL=postgres://postgres:postgres@localhost:5432/bullorbear

# Separate database for `npm test`'s integration suites (real Postgres, not mocked).
# Deliberately not the same database as DATABASE_URL above: integration tests insert
# real content_dna/sources/content_items rows and would collide with real onboarded
# data (content_dna only allows one active row at a time). Create it once with
# `createdb bullorbear_test` (or `psql -c "CREATE DATABASE bullorbear_test;"`), then
# apply the schema with `DATABASE_URL=<this value> npx tsx packages/db/src/migrate.ts`.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/bullorbear_test

# apps/api's HTTP port and bind address. API_HOST defaults to 127.0.0.1
# (loopback-only) even if left unset here, since apps/api has no authentication
# unless DASHBOARD_SHARED_SECRET (below) is also set. Only widen this deliberately
# — e.g. deploying apps/api so the dashboard works from a phone — alongside setting
# that secret; never widen API_HOST without it.
API_PORT=4000
API_HOST=127.0.0.1

# Single-operator shared-secret gate (apps/api/src/auth.ts) — required once API_HOST
# is widened beyond loopback (a real deployment like Render must set this to a long
# random value). Unset locally; every route except /health then requires this exact
# value as a `Authorization: Bearer <token>` header. The dashboard's LoginGate
# prompts for and stores it. Generate with `openssl rand -hex 32`.
DASHBOARD_SHARED_SECRET=

# Browser-enforced allowlist for cross-origin dashboard requests (apps/api/src/app.ts).
# Unset locally — the Vite dev proxy makes requests same-origin so CORS never
# applies. Once apps/api is deployed separately from the dashboard (e.g. Render +
# Netlify), set this to the dashboard's exact origin (no trailing slash, never `*`)
# or the browser blocks every cross-origin fetch.
CORS_ALLOWED_ORIGIN=

# X (Twitter) direct API publish connector (packages/mcp-servers/x) — spec's
# Connector Layer. Requires a Developer Portal app (developer.twitter.com) with
# "Read and Write" permissions and OAuth 1.0a user context enabled. Tried live on
# this account and rejected with 402 "credits-depleted" (X's free tier won't post),
# so this connector is left unregistered — kept only for if paid credits are ever
# added. All four must be set together or it's treated as unconfigured
# (packages/core/src/env.ts). `npm run x:verify` confirms the connected account
# without publishing anything.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Buffer publish connector (packages/mcp-servers/buffer) — the real, free X
# publish/schedule path (spec's Connector Layer), since X's own direct API above
# requires paid credits. BUFFER_ACCESS_TOKEN is a personal API key from
# https://publish.buffer.com/settings/api. BUFFER_CHANNEL_ID is the id of the
# connected X/Twitter channel to post to — run `npm run buffer:verify` (needs only
# the token) to list every channel on the account and find it. Both must be set
# together or the connector is treated as unconfigured (packages/core/src/env.ts)
# and publish/schedule requests to X fail with an honest "not configured"
# PUBLISH_EVENT (spec 15.4) instead of doing nothing.
BUFFER_ACCESS_TOKEN=
BUFFER_CHANNEL_ID=

# apps/worker (`npm run worker`) — polls for approved X content whose scheduled time
# has arrived and publishes it via the Buffer connector above at that moment. This
# is our own polling loop deciding *when*; Buffer is only used to actually post.
# Optional, ms, defaults to 60000 (1 minute).
WORKER_POLL_INTERVAL_MS=

# Blog git-push publish connector (packages/mcp-servers/blog-git) — spec's Connector
# Layer for platform "blog". The live site (bullorbear.in) is a static Astro site
# whose own GitHub Actions workflow deploys on every push to BLOG_REPO_BRANCH, so
# "publishing" a blog post means committing an MDX file into BLOG_REPO_PATH and
# pushing — there's no platform API to call. BLOG_REPO_PATH must be an existing
# local clone of that site's repo, on a machine that can already `git push` to it
# (same credentials a human would use to push manually) — leave unset to keep
# blog publish/schedule requests honestly failing as "not configured"
# (spec 15.4), same as X before Buffer was wired up.
BLOG_REPO_PATH=
BLOG_REPO_BRANCH=master
BLOG_SITE_BASE_URL=https://bullorbear.in

# Scheduled blog firing (supabase/functions/fire-due-schedules) — replaces
# apps/worker for platform "blog" specifically, so a scheduled post still publishes
# even if every local machine is offline. A Supabase pg_cron job calls this Edge
# Function once a minute; it publishes via GitHub's Contents API instead of a local
# `git push` (a stateless function has no persistent checkout).
#
# Deploy/redeploy with:
#   npx supabase link --project-ref <ref>
#   npx supabase functions deploy fire-due-schedules --no-verify-jwt --project-ref <ref>
#   npx supabase secrets set --project-ref <ref> --env-file <a temp file with the vars below>
#
# SUPABASE_ACCESS_TOKEN: a Personal Access Token (Supabase dashboard → Account
# Preferences → Access Tokens) with full read/write access, used only for the CLI
# commands above — never sent to the deployed function itself.
SUPABASE_ACCESS_TOKEN=

# CRON_SECRET: the shared secret pg_net sends as the `x-cron-secret` header so the
# function can reject requests that aren't really from our own cron job. Generate
# with `openssl rand -hex 32`. Must be set in THREE places, kept in sync: this var
# (for `supabase secrets set`), the function's own secret store, and the
# `cron_config` table row the pg_cron job in
# packages/db/migrations/0014_fire_due_schedules_cron.sql reads it from.
CRON_SECRET=

# GITHUB_TOKEN: a fine-grained GitHub PAT scoped to ONLY the blog repo
# (BLOG_REPO_OWNER/BLOG_REPO_NAME below), with "Contents: Read and write" permission
# and nothing else. Set as a function secret (`supabase secrets set`), never
# committed. Create at github.com → Settings → Developer settings → Fine-grained
# tokens.
BLOG_REPO_OWNER=
BLOG_REPO_NAME=

# Publish notification email (packages/core/src/notify.ts) — sent after any
# scheduled post actually publishes (apps/worker's poll loop, the apps/api
# /internal/scheduler/tick endpoint, and the fire-due-schedules Edge Function all
# call this), with the post's link. RESEND_API_KEY + NOTIFY_EMAIL_TO together
# enable it; leave either unset to skip notifications entirely (same
# "unset = honestly not configured" pattern as every connector above).
# RESEND_API_KEY: from https://resend.com/api-keys (free tier, no card required).
# NOTIFY_EMAIL_TO: the address that should receive the notification.
# NOTIFY_EMAIL_FROM: optional, defaults to Resend's no-verification-needed sandbox
# sender (onboarding@resend.dev) — sandbox mode only delivers to the email address
# on the Resend account itself; verify a domain in Resend to send to any address.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# The fire-due-schedules Edge Function (Deno, separate from this .env) needs its
# own copies of the three vars above to send blog-publish notification emails —
# set them alongside its other secrets:
#   npx supabase secrets set --project-ref <ref> RESEND_API_KEY=... NOTIFY_EMAIL_TO=...

# BB Visual Agent (packages/agents/visual, additive visual-production layer) — OFF
# by default. The existing text-only workflow is completely unaffected until this
# is deliberately turned on. See .agents/skills/bb-visual-agent/SKILL.md.
BB_VISUAL_AGENT_ENABLED=false

# Image generation reuses the Gemini account above (GEMINI_API_KEY) — only the
# model differs. Get an image-capable model name (e.g. gemini-2.5-flash-image) from
# https://aistudio.google.com/apikey. Leave unset to keep the visual stage's image
# provider honestly "not configured" (it will fail explicitly, never fake success).
GEMINI_IMAGE_MODEL=

# Supabase Storage — where generated visual assets actually live. Required because
# apps/api/apps/worker run on Render, whose filesystem is ephemeral across deploys
# (unlike BLOG_REPO_PATH, a git checkout that persists via GitHub). Create a bucket
# in the Supabase dashboard (Storage → New bucket, keep it PRIVATE — assets are
# served via signed URLs, never made public) and a service role key (Project
# Settings → API → service_role secret, NOT the anon key). SUPABASE_URL is the
# project's API URL (Project Settings → API → Project URL), not the Postgres
# connection string used by DATABASE_URL above.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=visual-assets
