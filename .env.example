# Search sources — the agent runs on Wikipedia alone (no key needed) and adds
# News/YouTube automatically once their keys below are set.

# Wikipedia REST API (packages/mcp-servers/search-wikipedia) — no key required.

# NewsAPI.org (packages/mcp-servers/search-news) — free dev tier, 100 req/day.
# https://newsapi.org/register
NEWS_API_KEY=

# YouTube Data API v3 (packages/mcp-servers/search-youtube) — metadata only,
# free quota. https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# LLM providers — tried in this order (Gemini primary, Groq fallback,
# OpenRouter further fallback), skipping any without a key. All three use
# an OpenAI-compatible /chat/completions endpoint (packages/core/src/llm.ts).
# At least one must be set.

# Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Groq (free tier) — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (free-tier models available) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Postgres (packages/db) — `docker compose up -d` runs a local instance
# matching this connection string. `npm run db:migrate` applies the schema.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_company_os

# apps/api's HTTP port. apps/dashboard proxies workflow-run requests here.
API_PORT=4000
API_BASE_URL=http://localhost:4000

# Trend Research agent's extra signal sources — like NEWS_API_KEY/
# YOUTUBE_API_KEY above, each is skipped gracefully (not faked) if unset.

# vidIQ (packages/mcp-servers/search-trends) — trend/virality signals.
# NOTE: this integration is scaffolded against a placeholder endpoint since
# vidIQ partner API access wasn't available to confirm; verify against real
# vidIQ API docs before relying on it.
VIDIQ_API_KEY=

# Brave Search API (packages/mcp-servers/search-competitors) — free tier,
# https://brave.com/search/api/. Searches each competitor domain's actual
# indexed content via a `site:` operator, not just their recent RSS posts.
# The domain list itself is checked-in code, not a secret — see
# packages/mcp-servers/search-competitors/src/competitorDomains.ts. Tracked
# competitor YouTube channels are a separate, checked-in list — see
# packages/agents/research-pack/src/competitorYoutubeChannels.ts.
BRAVE_SEARCH_API_KEY=

# Hacker News (packages/mcp-servers/search-hackernews) — no key needed, free
# Algolia-backed search. Community/tech discussion signal.

# Blog Publisher (packages/mcp-servers/publish-blog-git) — the ONLY agent
# that writes to your live site's repo. Your site (~/Downloads/BLOG,
# github.com/riya0108/bullorbear-blog) is a static Astro site with MDX
# content collections, deployed via a GitHub Actions workflow that builds
# and deploys on every push to BLOG_GIT_BRANCH. Publishing = committing an
# .mdx file to src/content/posts/ and pushing. Required for the "blog"
# workflow's publish step — unlike the optional search integrations above,
# this one fails loudly (not silently) if unset once a run reaches that
# step, since publishing is the pipeline's one irreversible action.
BLOG_REPO_PATH=/Users/teri/Downloads/BLOG
BLOG_GIT_BRANCH=master
BLOG_SITE_URL=https://bullorbear.in
# Safety default: "draft" — Astro's getStaticPaths excludes draft:true posts
# entirely at build time, so the commit ships and deploys but the page has
# no route yet. Set to "live" only once you trust the pipeline end-to-end.
BLOG_PUBLISH_STATUS=draft
